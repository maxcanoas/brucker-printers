# URL da API do sistema de chamados.
# Em desenvolvimento: http://<ip-da-maquina>:3001/api (o dispositivo precisa alcancar o IP)
# Em producao: https://<servico>.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Credenciais do projeto Supabase (mesmas do backend).
# A anon key pode ser commitada, mas preferimos tratar o .env como secret.
EXPO_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>
