# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key
SUPABASE_ANON_KEY=sua-anon-key

# JWT
JWT_SECRET=sua-chave-secreta-jwt

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=sua-account-sid
TWILIO_AUTH_TOKEN=seu-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SMTP - Gmail via App Password - padrão em produção/Render)
# Observação: solução temporária até destravar DMARC no domínio bruckerprinters.com.br.
# Depois disso, voltar para SMTP do cPanel (mail.bruckerprinters.com.br:465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-de-16-caracteres
SMTP_FROM=Brucker Chamados <seu-email@gmail.com>
NOTIFY_EMAILS=seu-email@gmail.com

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (CORS) - múltiplas URLs separadas por vírgula
FRONTEND_URL=http://localhost:5173,https://seu-dominio.vercel.app
